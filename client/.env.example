# Base URL the frontend calls for the API. Must include the /api/v1 prefix.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# --- Sentry (12.4, optional) — production builds only ---
# Public by design: a DSN is not a secret. From your React project in Sentry.
VITE_SENTRY_DSN=
# staging or production
VITE_SENTRY_ENVIRONMENT=

# Build-time only, for uploading source maps. Set these in Vercel, NOT here,
# and NEVER prefix the token with VITE_ — that would ship it to every browser.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
