# --- Server (required now) ---
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --- Database (required now) ---
# MongoDB Atlas SRV connection string, from your own dev cluster (not the client's).
MONGODB_URI=

# --- Auth (required once auth is built) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- File storage — Cloudinary (required once uploads are built) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email — Resend (required once transactional email is built) ---
RESEND_API_KEY=

# --- Payments — Stripe and/or PayPal, platform TBC (required once payments are built) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Error monitoring — Sentry (optional, add when wired up) ---
SENTRY_DSN=
