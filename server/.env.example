# --- Server (required now) ---
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --- Database (required now) ---
# MongoDB Atlas SRV connection string, from your own dev cluster (not the client's).
MONGODB_URI=

# --- Auth (REQUIRED NOW — the server will not start without these) ---
# Two DIFFERENT random secrets, each at least 32 characters.
# Generate each one with:  openssl rand -hex 32
# They must not match each other: if they did, a 7-day refresh token would also
# pass as a 15-minute access token, defeating the short access token entirely.
# Never commit the real values. Changing them logs everyone out immediately.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Admin seed (required only to run: npm run seed:admin) ---
# Used once, by scripts/seedAdmin.js, to create the single admin account.
# The API server does NOT require these to boot.
# ADMIN_PASSWORD must be at least 12 characters and at most 72 bytes.
# It is stored as a bcrypt hash and is never printed or recoverable — the only
# way back in is "Forgot password", so put it in a password manager now.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- File storage — Cloudinary (REQUIRED IN PRODUCTION; optional in development) ---
# Therapist applicants upload a profile photo and credential documents here.
# Without these in production the server REFUSES TO START — nobody could apply.
# In development the upload endpoint returns a clear 503 instead.
# Set all three or none: a partial config exits at startup in every environment.
#
# From cloudinary.com -> Settings -> API Keys.
#
# THE KEY NEEDS PERMISSIONS. Cloudinary's newer scoped keys are created with
# nothing granted, and every upload then fails with:
#   "Request forbidden due to missing permissions (actions=[\"create\"])"
# The signature and the request are fine — the key simply is not allowed.
# Grant at least CREATE and READ on the product environment, or use the account's
# master key.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email — Resend (REQUIRED IN PRODUCTION; optional in development) ---
# Without RESEND_API_KEY in development, emails print to the terminal instead of
# sending, so the reset flow can be tested with no Resend account. In production
# the server REFUSES TO START without it — silently undelivered password resets
# would lock users out with nothing in the logs to explain why.
#
# Get the key at resend.com -> API Keys. It starts with "re_".
RESEND_API_KEY=

# The sender address.
#
# DEVELOPMENT: onboarding@resend.dev is Resend's shared test sender. It can ONLY
# deliver to the address your Resend account is registered with.
#
# PRODUCTION (chunk 12.5): verify castofmind.com in Resend by adding DNS records
# at GoDaddy, then switch to: Cast of Mind <noreply@castofmind.com>
EMAIL_FROM=Cast of Mind <onboarding@resend.dev>

# Where contact form messages are delivered. REQUIRED IN PRODUCTION — without it
# the form would accept messages and silently drop them. In development, with no
# RESEND_API_KEY, messages print to the terminal instead.
CONTACT_TO=

# Public URL of the logo shown in email headers. Must be the INK version — the
# email background is white, so the white logo would be invisible. Optional: the
# template falls back to a text wordmark if this is unset.
EMAIL_LOGO_URL=

# --- Payments — Stripe (chunk 6.2 onwards) ---
#
# Stripe is the primary processor (master spec §12). Required in PRODUCTION;
# optional in development, where the checkout endpoint returns a clear 503 if
# it is unset so nobody working on chat needs payment credentials.
#
# Use a TEST key (sk_test_...) everywhere except production. Production refuses
# to start with a test key, because one would accept real subscriptions and
# never charge a card.
#
# There is deliberately NO publishable key: the browser is redirected to
# Stripe's hosted page by URL, so no Stripe.js runs in our frontend and no
# card detail ever reaches this application.
STRIPE_SECRET_KEY=

# The webhook signing secret. REQUIRED IN PRODUCTION since chunk 6.3 — without
# it no payment webhook can be verified, so no client account is ever created
# and the only symptom is silence.
#
# LOCAL: run `stripe listen --forward-to localhost:5000/api/v1/webhooks/payment`
# and copy the whsec_... it prints. This is NOT the same value as the dashboard
# endpoint secret, and it changes when you start a new `stripe listen` session.
#
# PRODUCTION: Stripe Dashboard -> Developers -> Webhooks -> your endpoint ->
# "Signing secret".
STRIPE_WEBHOOK_SECRET=

# PayPal is NOT integrated. §12 records it as an optional second processor and
# §21 still lists the final platform choice as an open item for the client.
# Adding it would be a separate integration, not a config change.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Error monitoring — Sentry (optional, add when wired up) ---
SENTRY_DSN=
