# --- Server (required now) ---
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --- Database (required now) ---
# MongoDB Atlas SRV connection string, from your own dev cluster (not the client's).
MONGODB_URI=

# --- Auth (REQUIRED NOW — the server will not start without these) ---
# Two DIFFERENT random secrets, each at least 32 characters.
# Generate each one with:  openssl rand -hex 32
# They must not match each other: if they did, a 7-day refresh token would also
# pass as a 15-minute access token, defeating the short access token entirely.
# Never commit the real values. Changing them logs everyone out immediately.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Admin seed (required only to run: npm run seed:admin) ---
# Used once, by scripts/seedAdmin.js, to create the single admin account.
# The API server does NOT require these to boot.
# ADMIN_PASSWORD must be at least 12 characters and at most 72 bytes.
# It is stored as a bcrypt hash and is never printed or recoverable — the only
# way back in is "Forgot password", so put it in a password manager now.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- File storage — Cloudinary (required once uploads are built) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email — Resend (REQUIRED IN PRODUCTION; optional in development) ---
# Without RESEND_API_KEY in development, emails print to the terminal instead of
# sending, so the reset flow can be tested with no Resend account. In production
# the server REFUSES TO START without it — silently undelivered password resets
# would lock users out with nothing in the logs to explain why.
#
# Get the key at resend.com -> API Keys. It starts with "re_".
RESEND_API_KEY=

# The sender address.
#
# DEVELOPMENT: onboarding@resend.dev is Resend's shared test sender. It can ONLY
# deliver to the address your Resend account is registered with.
#
# PRODUCTION (chunk 12.5): verify castofmind.com in Resend by adding DNS records
# at GoDaddy, then switch to: Cast of Mind <noreply@castofmind.com>
EMAIL_FROM=Cast of Mind <onboarding@resend.dev>

# Public URL of the logo shown in email headers. Must be the INK version — the
# email background is white, so the white logo would be invisible. Optional: the
# template falls back to a text wordmark if this is unset.
EMAIL_LOGO_URL=

# --- Payments — Stripe and/or PayPal, platform TBC (required once payments are built) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Error monitoring — Sentry (optional, add when wired up) ---
SENTRY_DSN=
